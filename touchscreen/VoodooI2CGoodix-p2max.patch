diff --git a/VoodooI2CGoodix/goodix.h b/VoodooI2CGoodix/goodix.h
index 93b7cbc..b86aa65 100644
--- a/VoodooI2CGoodix/goodix.h
+++ b/VoodooI2CGoodix/goodix.h
@@ -3,6 +3,26 @@
 
 #define GOODIX_VENDOR_ID    0x0416
 
+/* Physical active area of the digitiser, in 0.01 mm units.
+ * NOTE: this is a PHYSICAL DIMENSION, not a coordinate count. VoodooInput packs it
+ * verbatim into the MT2 "Sensor Surface Description" feature report (0xD9/0xDB), where
+ * macOS reads it as hundredths of a millimetre and uses it to turn normalised finger
+ * travel into millimetres for scroll and pinch magnitude. Assigning the coordinate
+ * range here (as this driver used to) makes macOS believe it is driving a 25.6 x 16.0 mm
+ * trackpad, which under-scales every relative gesture.
+ * GPD P2 MAX: 8.9" 2560x1600 16:10, EDID image size 192 x 120 mm. */
+#define GOODIX_PHYSICAL_MAX_X       19200   /* 192.00 mm */
+#define GOODIX_PHYSICAL_MAX_Y       12000   /* 120.00 mm */
+
+/* Gesture magnitude trim, percent of the physical size above.
+ * 100 = physically honest. Higher = faster scroll/pinch. Overridable at runtime via the
+ * GestureGainPercent key in the kext personality (no rebuild needed). */
+#define GOODIX_GESTURE_GAIN_DEFAULT 100
+#define GOODIX_GESTURE_GAIN_MIN     10
+#define GOODIX_GESTURE_GAIN_MAX     300
+/* 16-bit field in feature report 0xD9; overflowing it silently wraps to a tiny surface. */
+#define GOODIX_PHYSICAL_MAX_LIMIT   65535
+
 #define GOODIX_READ_COOR_ADDR           0x814E
 #define GOODIX_GT1X_REG_CONFIG_DATA     0x8050
 #define GOODIX_GT9X_REG_CONFIG_DATA     0x8047
