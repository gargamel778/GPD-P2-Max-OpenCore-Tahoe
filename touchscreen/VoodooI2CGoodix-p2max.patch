diff --git a/VoodooI2CGoodix/VoodooI2CGoodixTouchDriver.cpp b/VoodooI2CGoodix/VoodooI2CGoodixTouchDriver.cpp
index 3a292fb..3f55a11 100644
--- a/VoodooI2CGoodix/VoodooI2CGoodixTouchDriver.cpp
+++ b/VoodooI2CGoodix/VoodooI2CGoodixTouchDriver.cpp
@@ -212,7 +212,38 @@ bool VoodooI2CGoodixTouchDriver::start(IOService* provider) {
         goto start_exit;
     }
 
-    event_driver->configureMultitouchInterface(ts->abs_x_max, ts->abs_y_max, GOODIX_MAX_CONTACTS, GOODIX_VENDOR_ID);
+    // Scoped so the earlier `goto start_exit` statements do not jump over these
+    // initialisations (C++ forbids that).
+    {
+    // Physical surface size in 0.01mm units, with an optional gain trim. Both are
+    // overridable from the kext personality, so gesture speed can be retuned by editing
+    // the deployed Info.plist and rebooting - no rebuild.
+    UInt32 phys_x = GOODIX_PHYSICAL_MAX_X;
+    UInt32 phys_y = GOODIX_PHYSICAL_MAX_Y;
+    UInt32 gain = GOODIX_GESTURE_GAIN_DEFAULT;
+    OSNumber* tune;
+    if ((tune = OSDynamicCast(OSNumber, getProperty("PhysicalSurfaceWidth"))))
+        phys_x = tune->unsigned32BitValue();
+    if ((tune = OSDynamicCast(OSNumber, getProperty("PhysicalSurfaceHeight"))))
+        phys_y = tune->unsigned32BitValue();
+    if ((tune = OSDynamicCast(OSNumber, getProperty("GestureGainPercent"))))
+        gain = tune->unsigned32BitValue();
+
+    if (gain < GOODIX_GESTURE_GAIN_MIN) gain = GOODIX_GESTURE_GAIN_MIN;
+    if (gain > GOODIX_GESTURE_GAIN_MAX) gain = GOODIX_GESTURE_GAIN_MAX;
+
+    phys_x = (UInt32)(((UInt64)phys_x * gain) / 100);
+    phys_y = (UInt32)(((UInt64)phys_y * gain) / 100);
+    if (phys_x > GOODIX_PHYSICAL_MAX_LIMIT) phys_x = GOODIX_PHYSICAL_MAX_LIMIT;
+    if (phys_y > GOODIX_PHYSICAL_MAX_LIMIT) phys_y = GOODIX_PHYSICAL_MAX_LIMIT;
+
+    // Readable via: ioreg -c VoodooI2CGoodixTouchDriver -r -d1
+    setProperty("GoodixGestureGainPercent", (unsigned long long)gain, 32);
+    setProperty("GoodixSurfaceWidth_hundredths_mm", (unsigned long long)phys_x, 32);
+    setProperty("GoodixSurfaceHeight_hundredths_mm", (unsigned long long)phys_y, 32);
+
+    event_driver->configureMultitouchInterface(ts->abs_x_max, ts->abs_y_max, phys_x, phys_y, GOODIX_MAX_CONTACTS, GOODIX_VENDOR_ID);
+    }
     event_driver->registerService();
 
     registerService();
@@ -224,6 +255,12 @@ start_exit:
 }
 
